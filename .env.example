# Supabase (Project Settings → API). Public values are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose. Used by checkout, the Stripe webhook and order tracking.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys). Start with test-mode keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site URL (no trailing slash), used for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Turn on once Stripe Tax is set up in the Stripe dashboard (origin address + registrations).
STRIPE_AUTOMATIC_TAX=false
